<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient android:angle="315" android:startColor="#FF2A2150" android:centerColor="#FF211A3D" android:endColor="#FF15112B" />
        </shape>
    </item>
    <item android:bottom="40dp">
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient android:angle="270" android:startColor="#1AFFFFFF" android:endColor="#00FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <stroke android:width="1dp" android:color="#33FFFFFF" />
        </shape>
    </item>
</layer-list>
