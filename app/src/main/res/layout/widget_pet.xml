<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_kawaii"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <ViewFlipper
            android:id="@+id/pet_flipper"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:autoStart="true"
            android:flipInterval="600">
            <ImageView
                android:id="@+id/frame0"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/widget_pet"
                android:scaleType="fitCenter" />
            <ImageView
                android:id="@+id/frame1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/widget_pet"
                android:scaleType="fitCenter" />
            <ImageView
                android:id="@+id/frame2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/widget_pet"
                android:scaleType="fitCenter" />
            <ImageView
                android:id="@+id/frame3"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/widget_pet"
                android:scaleType="fitCenter" />
        </ViewFlipper>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1.35"
            android:orientation="vertical">

            <TextView
                android:id="@+id/name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/app_name"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/bars"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/label_satiety"
                        android:layout_width="18dp"
                        android:layout_height="wrap_content"
                        android:text="🍙"
                        android:textSize="10sp" />
                    <ProgressBar
                        android:id="@+id/bar_satiety"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="0dp"
                        android:layout_height="6dp"
                        android:layout_weight="1"
                        android:max="100"
                        android:maxHeight="6dp"
                        android:minHeight="6dp"
                        android:progress="50"
                        android:progressDrawable="@drawable/widget_bar_satiety" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/label_joy"
                        android:layout_width="18dp"
                        android:layout_height="wrap_content"
                        android:text="😊"
                        android:textSize="10sp" />
                    <ProgressBar
                        android:id="@+id/bar_joy"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="0dp"
                        android:layout_height="6dp"
                        android:layout_weight="1"
                        android:max="100"
                        android:maxHeight="6dp"
                        android:minHeight="6dp"
                        android:progress="50"
                        android:progressDrawable="@drawable/widget_bar_joy" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/label_energy"
                        android:layout_width="18dp"
                        android:layout_height="wrap_content"
                        android:text="⚡"
                        android:textSize="10sp" />
                    <ProgressBar
                        android:id="@+id/bar_energy"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="0dp"
                        android:layout_height="6dp"
                        android:layout_weight="1"
                        android:max="100"
                        android:maxHeight="6dp"
                        android:minHeight="6dp"
                        android:progress="50"
                        android:progressDrawable="@drawable/widget_bar_energy" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/label_hygiene"
                        android:layout_width="18dp"
                        android:layout_height="wrap_content"
                        android:text="🫧"
                        android:textSize="10sp" />
                    <ProgressBar
                        android:id="@+id/bar_hygiene"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="0dp"
                        android:layout_height="6dp"
                        android:layout_weight="1"
                        android:max="100"
                        android:maxHeight="6dp"
                        android:minHeight="6dp"
                        android:progress="50"
                        android:progressDrawable="@drawable/widget_bar_hygiene" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/buttons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/btn_feed"
                    android:layout_width="0dp"
                    android:layout_height="30dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/widget_btn_kawaii"
                    android:contentDescription="@string/widget_feed"
                    android:gravity="center"
                    android:text="🍙"
                    android:textSize="15sp" />
                <TextView
                    android:id="@+id/btn_play"
                    android:layout_width="0dp"
                    android:layout_height="30dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/widget_btn_kawaii"
                    android:contentDescription="@string/widget_play"
                    android:gravity="center"
                    android:text="🎾"
                    android:textSize="15sp" />
                <TextView
                    android:id="@+id/btn_clean"
                    android:layout_width="0dp"
                    android:layout_height="30dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/widget_btn_kawaii"
                    android:contentDescription="@string/widget_clean"
                    android:gravity="center"
                    android:text="🫧"
                    android:textSize="15sp" />
                <TextView
                    android:id="@+id/btn_sleep"
                    android:layout_width="0dp"
                    android:layout_height="30dp"
                    android:layout_weight="1"
                    android:background="@drawable/widget_btn_kawaii"
                    android:contentDescription="@string/widget_sleep"
                    android:gravity="center"
                    android:text="🌙"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
